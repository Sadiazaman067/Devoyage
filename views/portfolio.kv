#:import theme views.theme
#:import hex_color kivy.utils.get_hex_from_color

# Portfolio Log (Milestone 3 design). PortfolioScreen is an AppPage
# (sidebar + header); portfolio.py puts a PortfolioBody in its content.
# CategoryChip (the pill filter) comes from resources.kv.

<SummaryTile>:
    size_hint_y: None
    height: dp(76)
    radius: 14
    padding: [dp(16), dp(12)]
    spacing: dp(12)
    Icon:
        name: root.icon_name
        color: theme.C.blue
        size: dp(40), dp(40)
        pos_hint: {"center_y": 0.5}
        canvas.before:
            Color:
                rgba: theme.C.blue_tint
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(10)]
    BoxLayout:
        orientation: "vertical"
        Label:
            text: str(root.count)
            bold: True
            font_size: "22sp"
            color: theme.C.ink
            text_size: self.size
            halign: "left"
            valign: "bottom"
        Label:
            text: root.label
            font_size: "13sp"
            color: theme.C.muted
            text_size: self.size
            halign: "left"
            valign: "top"
            shorten: True

<EntryCard>:
    size_hint_y: None
    height: max(dp(84), middle.height + dp(36))
    radius: 14
    padding: [dp(20), dp(18)]
    spacing: dp(16)
    Icon:
        name: root.icon_name
        color: theme.C.blue
        size: dp(44), dp(44)
        pos_hint: {"top": 1}
        canvas.before:
            Color:
                rgba: theme.C.sidebar
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(10)]
    BoxLayout:
        id: middle
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        pos_hint: {"top": 1}
        # No spacing here: each optional row below carries its own top gap,
        # so a card without a step, note, or link has no empty gaps.
        Label:
            text: root.title
            font_name: "InterSemiBold"
            font_size: "16sp"
            color: theme.C.ink
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1]
        Label:
            text: root.meta
            font_size: "13sp"
            color: theme.C.muted
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1] + dp(6)
            valign: "bottom"
        BoxLayout:
            size_hint_y: None
            height: dp(38) if root.step_title else 0
            padding: [0, dp(10), 0, 0]
            opacity: 1 if root.step_title else 0
            Chip:
                text: "Roadmap step: " + root.step_title
                fill: theme.C.mint
                color: theme.C.mint_ink
            Widget:
        BoxLayout:
            size_hint_y: None
            height: note_label.height + dp(10) if root.note else 0
            padding: [0, dp(10), 0, 0]
            opacity: 1 if root.note else 0
            Label:
                id: note_label
                text: root.note
                font_size: "14sp"
                color: theme.C.ink
                line_height: 1.25
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]
        BoxLayout:
            size_hint_y: None
            height: link_label.height + dp(8) if root.link else 0
            padding: [0, dp(8), 0, 0]
            opacity: 1 if root.link else 0
            Label:
                id: link_label
                markup: True
                text: "[ref=open][color=" + hex_color(theme.C.blue) + "]" + root.link_display + "[/color][/ref]" if root.link else ""
                font_size: "14sp"
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]
                shorten: True
                on_ref_press: root.open_link()
    BoxLayout:
        size_hint: None, None
        size: dp(76), dp(32)
        pos_hint: {"top": 1}
        spacing: dp(12)
        IconButton:
            name: "pencil"
            size: dp(32), dp(32)
            on_release: root.screen.open_form(root.entry_id)
        IconButton:
            name: "trash"
            color: theme.C.crimson
            size: dp(32), dp(32)
            on_release: root.screen.confirm_delete(root.entry_id)

<PortfolioBody>:
    orientation: "vertical"
    spacing: dp(16)
    GridLayout:
        id: summary
        cols: 5
        size_hint_y: None
        height: dp(76)
        spacing: dp(14)
    BoxLayout:
        size_hint_y: None
        height: dp(44)
        spacing: dp(10)
        BoxLayout:
            id: chips
            spacing: dp(10)
            padding: [0, dp(2)]
        PrimaryButton:
            text: "Add entry"
            icon_name: "plus"
            on_release: root.screen.open_form(None)
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        SuccessBox:
            message: root.success
        ErrorBox:
            message: root.error
    ScrollView:
        do_scroll_x: False
        bar_width: dp(6)
        bar_color: theme.C.checkbox
        bar_inactive_color: theme.C.line
        BoxLayout:
            id: entry_list
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            padding: [0, 0, dp(10), dp(24)]
            spacing: dp(14)
            Label:
                id: empty_label
                text: ""
                font_size: "15sp"
                color: theme.C.muted
                text_size: self.width, None
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1] + dp(40) if self.text else 0

# ---- Add / Edit form ------------------------------------------------------

<StepOption>:
    size_hint_y: None
    height: dp(44)
    padding: [dp(14), 0]
    font_size: "14sp"
    color: theme.C.ink
    text_size: self.width - dp(28), None
    halign: "left"
    valign: "middle"
    shorten: True
    canvas.before:
        Color:
            rgba: theme.C.blue_tint if (self.selected or self.state == "down") else theme.C.bg
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: theme.C.line
        Line:
            points: [self.x, self.y, self.right, self.y]

<StepDropDown>:
    max_height: dp(300)
    canvas.before:
        Color:
            rgba: theme.C.line
        Line:
            width: 1
            rectangle: (self.x, self.y, self.width, self.height)

<NoteField@Card>:
    radius: 10
    size_hint_y: None
    height: dp(96)
    padding: [dp(14), dp(10)]

<EntryForm>:
    size_hint: None, None
    size: dp(620), min(dp(720), self.window_height - dp(40))
    auto_dismiss: False
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, 0.45
    Card:
        orientation: "vertical"
        padding: [dp(28), dp(24)]
        spacing: dp(14)
        BoxLayout:
            size_hint_y: None
            height: dp(32)
            Label:
                text: root.heading
                bold: True
                font_size: "21sp"
                color: theme.C.ink
                text_size: self.size
                halign: "left"
                valign: "middle"
            IconButton:
                name: "x"
                size: dp(32), dp(32)
                pos_hint: {"center_y": 0.5}
                on_release: root.dismiss()
        ScrollView:
            do_scroll_x: False
            bar_width: dp(5)
            bar_color: theme.C.checkbox
            bar_inactive_color: theme.C.line
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: [0, 0, dp(8), dp(4)]
                spacing: dp(8)
                FieldTitle:
                    text: "Type"
                StackLayout:
                    id: type_chips
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(8)
                Widget:
                    size_hint_y: None
                    height: dp(4)
                FieldTitle:
                    text: "Title"
                TextField:
                    id: title_field
                    hint_text: "e.g. Personal website, CSC 317, HackUSM"
                    invalid: root.bad_field == "title"
                Widget:
                    size_hint_y: None
                    height: dp(4)
                BoxLayout:
                    size_hint_y: None
                    height: dp(78)
                    spacing: dp(14)
                    BoxLayout:
                        orientation: "vertical"
                        spacing: dp(8)
                        size_hint_x: 0.42
                        FieldTitle:
                            text: "Start date"
                        TextField:
                            id: date_field
                            icon_name: "calendar"
                            hint_text: "YYYY-MM-DD"
                            invalid: root.bad_field == "start_date"
                    BoxLayout:
                        orientation: "vertical"
                        spacing: dp(8)
                        FieldTitle:
                            text: "Link (optional)"
                        TextField:
                            id: link_field
                            icon_name: "external-link"
                            hint_text: "https://github.com/..."
                            invalid: root.bad_field == "link"
                Widget:
                    size_hint_y: None
                    height: dp(4)
                BoxLayout:
                    size_hint_y: None
                    height: dp(22)
                    FieldTitle:
                        text: "Note (optional)"
                    Label:
                        text: str(len(note_input.text)) + " / 500"
                        font_size: "13sp"
                        color: theme.C.crimson if len(note_input.text) > 500 else theme.C.muted
                        text_size: self.size
                        halign: "right"
                        valign: "bottom"
                NoteField:
                    border_color: theme.C.crimson if root.bad_field == "note" else (theme.C.blue if note_input.focus else theme.C.line)
                    TextInput:
                        id: note_input
                        hint_text: "What you built, learned, or applied for."
                        multiline: True
                        write_tab: False
                        font_size: "15sp"
                        foreground_color: theme.C.ink
                        hint_text_color: theme.C.text_faint
                        cursor_color: theme.C.blue
                        background_normal: ""
                        background_active: ""
                        background_color: 0, 0, 0, 0
                        padding: [0, dp(4)]
                Widget:
                    size_hint_y: None
                    height: dp(4)
                FieldTitle:
                    text: "Link to a roadmap step (optional)"
                Card:
                    id: step_button
                    radius: 10
                    size_hint_y: None
                    height: dp(48)
                    padding: [dp(14), 0]
                    spacing: dp(10)
                    opacity: 1 if root.has_steps else 0.6
                    Icon:
                        name: "map"
                        color: theme.C.muted
                        font_size: "17sp"
                        size: dp(20), dp(20)
                        pos_hint: {"center_y": 0.5}
                    Label:
                        text: root.step_label
                        font_size: "15sp"
                        color: theme.C.ink if root.step_id else theme.C.text_faint
                        text_size: self.size
                        halign: "left"
                        valign: "middle"
                        shorten: True
                    Icon:
                        name: "chevron-down"
                        color: theme.C.muted
                        font_size: "17sp"
                        size: (dp(20), dp(20)) if root.has_steps else (0, 0)
                        pos_hint: {"center_y": 0.5}
        ErrorBox:
            message: root.error
        BoxLayout:
            size_hint_y: None
            height: dp(46)
            spacing: dp(12)
            Widget:
            GhostButton:
                text: "Cancel"
                on_release: root.dismiss()
            PrimaryButton:
                text: root.save_text
                icon_name: "check"
                on_release: root.save()

<ConfirmDeleteEntry>:
    size_hint: None, None
    size: dp(460), dp(210)
    auto_dismiss: True
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, 0.45
    Card:
        orientation: "vertical"
        padding: [dp(26), dp(22)]
        spacing: dp(12)
        Label:
            text: "Delete this entry?"
            bold: True
            font_size: "20sp"
            color: theme.C.ink
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1]
        Label:
            text: '"' + root.entry_title + '" will be removed from your Portfolio Log. This can\'t be undone.'
            font_size: "15sp"
            color: theme.C.muted
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1]
        Widget:
        BoxLayout:
            size_hint_y: None
            height: dp(46)
            spacing: dp(12)
            Widget:
            GhostButton:
                text: "Cancel"
                on_release: root.dismiss()
            DangerButton:
                text: "Delete"
                icon_name: "trash"
                on_release: root.confirmed()
