#:import theme views.theme

# Intake (Milestone 3 design): six steps with Back and Next instead of one
# long form. The questions themselves are built in intake.py from the STEPS
# list, so this file is only the frame: header, step indicator, the main
# card, and the "Why we ask" / "So far" side panel.

# One circle + label in the step indicator.
<StepDot>:
    orientation: "vertical"
    size_hint_x: None
    width: dp(150)
    spacing: dp(6)
    AnchorLayout:
        size_hint_y: None
        height: dp(40)
        Widget:
            size_hint: None, None
            size: dp(38), dp(38)
            canvas:
                Color:
                    rgba: theme.C.blue if root.state_name == "done" else theme.C.bg
                Ellipse:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: theme.C.blue if root.state_name in ("done", "current") else theme.C.checkbox
                Line:
                    width: 1.6 if root.state_name == "current" else 1.1
                    circle: (self.center_x, self.center_y, self.width / 2)
            Label:
                font_name: "Icons" if root.state_name == "done" else "InterSemiBold"
                text: root.check_char if root.state_name == "done" else str(root.number)
                font_size: "16sp"
                color: theme.C.bg if root.state_name == "done" else (theme.C.blue if root.state_name == "current" else theme.C.muted)
                pos: self.parent.pos
                size: self.parent.size
    Label:
        text: root.label
        font_name: "InterSemiBold" if root.state_name == "current" else "Inter"
        font_size: "14sp"
        color: theme.C.blue if root.state_name == "current" else theme.C.muted
        size_hint_y: None
        height: dp(20)

<StepLine@Widget>:
    done: False
    size_hint_y: None
    height: dp(40)
    canvas:
        Color:
            rgba: theme.C.blue if self.done else theme.C.line
        Rectangle:
            pos: self.x + dp(6), self.center_y - dp(1)
            size: self.width - dp(12), dp(2)

# A question heading inside a step.
<QuestionTitle@Label>:
    font_name: "InterSemiBold"
    font_size: "16sp"
    color: theme.C.ink
    text_size: self.width, None
    size_hint_y: None
    height: self.texture_size[1] + dp(6)

<SideNote@Label>:
    font_size: "15sp"
    color: theme.C.ink
    line_height: 1.3
    text_size: self.width, None
    size_hint_y: None
    height: self.texture_size[1]

<IntakeScreen>:
    canvas.before:
        Color:
            rgba: theme.C.bg
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: "vertical"
        padding: [dp(48), dp(22), dp(48), dp(24)]
        spacing: dp(18)

        # ---- Header ----
        BoxLayout:
            size_hint_y: None
            height: dp(36)
            spacing: dp(10)
            Icon:
                name: "compass"
                font_size: "24sp"
                size: dp(28), dp(28)
                pos_hint: {"center_y": 0.5}
            Label:
                text: "Devoyage"
                bold: True
                font_size: "20sp"
                color: theme.C.ink
                size_hint_x: None
                width: self.texture_size[0]
            Widget:
            Label:
                markup: True
                text: "[font=Icons]" + root.clock_char + "[/font]  About 5 minutes total"
                font_size: "14sp"
                color: theme.C.muted
                size_hint_x: None
                width: self.texture_size[0]

        # ---- Step indicator (filled in by intake.py) ----
        BoxLayout:
            id: steps_bar
            size_hint_y: None
            height: dp(68)

        # ---- Main card + side panel ----
        BoxLayout:
            spacing: dp(24)
            Card:
                orientation: "vertical"
                padding: [dp(32), dp(26), dp(32), dp(22)]
                spacing: dp(8)
                Label:
                    text: root.eyebrow
                    font_name: "InterSemiBold"
                    font_size: "13sp"
                    color: theme.C.muted
                    size_hint_y: None
                    height: dp(18)
                    text_size: self.size
                    halign: "left"
                Label:
                    text: root.question
                    bold: True
                    font_size: "26sp"
                    color: theme.C.ink
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]
                Label:
                    text: root.hint
                    font_size: "15sp"
                    color: theme.C.muted
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1] + dp(8)
                ScrollView:
                    do_scroll_x: False
                    bar_width: dp(5)
                    bar_color: theme.C.checkbox
                    bar_inactive_color: theme.C.line
                    BoxLayout:
                        id: step_body
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        padding: [0, dp(4), dp(10), dp(4)]
                        spacing: dp(12)
                ErrorBox:
                    id: error_box
                BoxLayout:
                    size_hint_y: None
                    height: dp(48)
                    GhostButton:
                        text: "Back"
                        icon_name: "arrow-left"
                        height: dp(46)
                        opacity: 0 if root.step_index == 0 else 1
                        disabled: root.step_index == 0
                        on_release: root.go_back()
                    Widget:
                    PrimaryButton:
                        text: "Generate my roadmap" if root.step_index == 5 else "Next"
                        icon_name: "sparkles" if root.step_index == 5 else "arrow-right"
                        icon_right: root.step_index != 5
                        height: dp(46)
                        on_release: root.go_next()

            BoxLayout:
                orientation: "vertical"
                size_hint_x: None
                width: dp(360)
                spacing: dp(18)
                Card:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    bg_color: theme.C.mint_soft
                    border_color: theme.C.mint_line
                    padding: [dp(22), dp(20)]
                    spacing: dp(8)
                    QuestionTitle:
                        text: "Why we ask"
                        font_size: "18sp"
                    SideNote:
                        text: root.why_text
                Card:
                    id: so_far_card
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [dp(22), dp(20)]
                    spacing: dp(8)
                    QuestionTitle:
                        text: "So far"
                        font_size: "18sp"
                    SideNote:
                        text: root.so_far_text or "Your answers will show up here."
                        color: theme.C.muted
                    SideNote:
                        text: "You can change your weekly hours later in Settings."
                        color: theme.C.blue
                        font_name: "InterSemiBold"
                        font_size: "14sp"
                Widget:
