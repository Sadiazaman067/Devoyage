#:import theme views.theme
#:import helpers views.dashboard_helpers
#:import icon views.icons.icon

# Dashboard layout. Matches _notes/handoff/wireframes/dashboard.html and
# dashboard_states.html. Behaviour lives in dashboard.py.
#
# Every color comes from views/theme.py (theme.C.<name>). Kivy's default
# label color is white, so every label here sets its color explicitly.
#
# Names starting with "Dash" are small reusable pieces. KV class names are
# global across all loaded .kv files, so the prefix keeps them from
# colliding with intake.kv's FieldLabel etc. Two are dynamic classes made
# with @ (DashLabel, DashNotNowFrame); the rest have a Python class in
# dashboard.py because they have their own properties (see the note there).


# =========================================================================
# Reusable pieces
# =========================================================================

# A label that wraps to its width and grows to fit its text.
<DashLabel@Label>:
    color: theme.C.text_body
    font_size: "14sp"
    halign: "left"
    valign: "top"
    text_size: self.width, None        # wrap at the label's width...
    size_hint_y: None
    height: self.texture_size[1]       # ...and be exactly as tall as the wrapped text

# Small rounded badge: est_time, "Up next", "Done", the current nav item.
<DashPill>:
    fill: theme.C.chip_bg
    color: theme.C.text_muted
    font_size: "12sp"
    bold: True
    size_hint: None, None
    width: (self.texture_size[0] + dp(20)) if self.shown else 0
    opacity: 1 if self.shown else 0
    height: dp(24)
    canvas.before:
        Color:
            rgba: self.fill
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]

# Rounded button. background_normal "" turns off Kivy's default grey image;
# the pill shape is drawn in canvas.before instead.
<DashPillButton>:
    fill: theme.C.accent
    outline: theme.C.clear
    color: theme.C.on_accent
    disabled_color: self.color
    font_size: "15sp"
    bold: True
    background_normal: ""
    background_down: ""
    background_disabled_normal: ""
    background_color: theme.C.clear
    size_hint: None, None
    width: self.texture_size[0] + self.pad_x
    height: dp(44)
    opacity: 0.45 if self.disabled else (0.8 if self.state == "down" else 1)
    canvas.before:
        Color:
            rgba: self.fill
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
        Color:
            rgba: self.outline
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, self.height / 2)
            width: dp(1.2)

# White card with a thin border (loading and error states).
<DashCardFrame>:
    frame_fill: theme.C.surface
    frame_line: theme.C.border
    frame_line_width: dp(1)
    canvas.before:
        Color:
            rgba: self.frame_fill
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: self.frame_line
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(16))
            width: self.frame_line_width

# The not-now panel's frame: warm background, dashed border.
<DashNotNowFrame@BoxLayout>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: dp(22)
    spacing: dp(14)
    canvas.before:
        Color:
            rgba: theme.C.notnow_bg
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: theme.C.notnow_border
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(16))
            # Kivy only draws dashes on lines that are exactly 1 pixel wide.
            width: 1
            dash_length: dp(6)
            dash_offset: dp(4)

<DashProgressBar>:
    canvas:
        Color:
            rgba: theme.C.border
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
        Color:
            rgba: theme.C.accent
        RoundedRectangle:
            pos: self.pos
            size: self.width * self.value, self.height
            radius: [self.height / 2]

<DashSkeletonBar>:
    fill: theme.C.skeleton_bar
    size_hint_y: None
    canvas:
        Color:
            rgba: self.fill
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]

# Grey placeholder shaped like a step card, shown while generating.
<DashSkeletonCard>:
    title_share: 0.6
    line_share: 0.85
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: [dp(24), dp(22)]
    spacing: dp(12)
    DashSkeletonBar:
        height: dp(18)
        size_hint_x: root.title_share
    DashSkeletonBar:
        height: dp(12)
        size_hint_x: root.line_share
    DashSkeletonBar:
        height: dp(44)
        fill: theme.C.skeleton_why


# =========================================================================
# Milestone 3 pieces (Python classes in dashboard.py)
# =========================================================================

# One step in the Weekly Focus panel: a checkbox and the step's title.
<FocusItem>:
    orientation: "horizontal"
    size_hint_y: None
    height: max(dp(56), focus_title.height + dp(24))
    padding: [dp(16), 0]
    spacing: dp(12)
    canvas.before:
        Color:
            rgba: theme.C.bg
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
        Color:
            rgba: theme.C.mint_line
        Line:
            width: 1
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(10))
    TickBox:
        checked: root.done
        pos_hint: {"center_y": 0.5}
        on_release: root.screen.toggle_step(root.step_id, not root.done)
    Label:
        id: focus_title
        text: root.title
        font_name: "InterSemiBold"
        font_size: "15sp"
        color: theme.C.muted if root.done else theme.C.ink
        strikethrough: root.done
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1]
        pos_hint: {"center_y": 0.5}

# One roadmap step: checkbox, title, description, time chip, expand arrow.
# The "Why this, why now" box is added and removed by StepRow.on_expanded.
<StepRow>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: [dp(18), dp(14)]
    spacing: dp(12)
    canvas.before:
        Color:
            rgba: theme.C.bg
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        Color:
            rgba: theme.C.blue_line if (root.expanded and not root.done) else theme.C.line
        Line:
            width: 1.2 if (root.expanded and not root.done) else 1
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(12))

    BoxLayout:
        size_hint_y: None
        height: max(dp(40), text_col.height)
        spacing: dp(14)
        TickBox:
            checked: root.done
            pos_hint: {"center_y": 0.5}
            on_release: root.screen.toggle_step(root.step_id, not root.done)
        BoxLayout:
            id: text_col
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            pos_hint: {"center_y": 0.5}
            spacing: dp(2)
            Label:
                text: root.title
                font_name: "InterSemiBold"
                font_size: "16sp"
                color: theme.C.muted if root.done else theme.C.ink
                strikethrough: root.done
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]
            Label:
                text: root.description
                font_size: "14sp"
                color: theme.C.muted
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]
        Chip:
            markup: True
            text: ("[font=Icons]" + icon("check") + "[/font]  Done") if root.done else (("[font=Icons]" + icon("clock") + "[/font]  " + root.time_label) if root.time_label else "")
            fill: theme.C.mint if root.done else theme.C.chip_gray
            color: theme.C.mint_ink if root.done else theme.C.muted
            opacity: 1 if (root.done or root.time_label) else 0
            pos_hint: {"center_y": 0.5}
        IconButton:
            name: "chevron-down"
            size: dp(28), dp(28)
            color: theme.C.blue if root.expanded else theme.C.muted
            opacity: 0 if root.done else 1
            disabled: root.done
            pos_hint: {"center_y": 0.5}
            on_release: root.screen.toggle_expanded(root.step_id)

    BoxLayout:
        id: why
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        padding: [dp(18), dp(14)]
        spacing: dp(6)
        canvas.before:
            Color:
                rgba: theme.C.blue_tint
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(10)]
        Label:
            markup: True
            text: "[font=Icons]" + icon("lightbulb") + "[/font]  WHY THIS, WHY NOW"
            font_name: "InterSemiBold"
            font_size: "12sp"
            color: theme.C.blue
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1]
        Label:
            text: root.reasoning
            font_size: "14sp"
            color: theme.C.ink
            line_height: 1.25
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1]

# One Not Now item: title, reason, and a line above it.
<NotNowItem>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: [0, dp(14), 0, 0]
    spacing: dp(4)
    canvas.before:
        Color:
            rgba: theme.C.notnow_divider
        Rectangle:
            pos: self.x, self.top - dp(1)
            size: self.width, dp(1)
    Label:
        text: root.title
        font_name: "InterSemiBold"
        font_size: "16sp"
        color: theme.C.ink
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1]
    Label:
        text: root.reasoning
        font_size: "14sp"
        color: theme.C.muted
        line_height: 1.2
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1]

# Card heading: icon + title + subtitle.
<PanelHeading@BoxLayout>:
    icon_name: "map"
    title: ""
    subtitle: ""
    title_color: theme.C.ink
    icon_color: theme.C.blue
    size_hint_y: None
    height: dp(48) if self.subtitle else dp(28)
    spacing: dp(12)
    Icon:
        name: root.icon_name
        color: root.icon_color
        font_size: "22sp"
        size: dp(26), dp(26)
        pos_hint: {"top": 1}
    BoxLayout:
        orientation: "vertical"
        Label:
            text: root.title
            bold: True
            font_size: "20sp"
            color: root.title_color
            text_size: self.size
            halign: "left"
            valign: "middle"
            size_hint_y: None
            height: dp(26)
        Label:
            text: root.subtitle
            font_size: "14sp"
            color: theme.C.muted
            text_size: self.size
            halign: "left"
            valign: "top"


<LoadingRing>:
    size_hint: None, None
    size: dp(26), dp(26)
    canvas:
        Color:
            rgba: theme.C.spinner_track
        Line:
            circle: (self.center_x, self.center_y, self.width / 2 - dp(2))
            width: dp(1.5)
        Color:
            rgba: theme.C.accent
        Line:
            # circle: (x, y, radius, start angle, end angle) -> a 90-degree arc
            circle: (self.center_x, self.center_y, self.width / 2 - dp(2), self.angle, self.angle + 90)
            width: dp(1.5)


# =========================================================================
# State 1: the roadmap
# =========================================================================

<DashboardRoadmapView>:
    stacked: helpers.use_stacked_layout(self.width / dp(1))
    do_scroll_x: False
    bar_width: dp(6)
    bar_color: theme.C.checkbox
    bar_inactive_color: theme.C.line
    scroll_type: ["bars", "content"]

    # A ScrollView holds exactly one child, as tall as its content.
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        padding: [0, 0, dp(10), dp(24)]
        spacing: dp(22)

        # ---- Row 1: Weekly Focus + Progress ----
        BoxLayout:
            orientation: "vertical" if root.stacked else "horizontal"
            size_hint_y: None
            height: self.minimum_height if root.stacked else max(focus_card.minimum_height, progress_card.minimum_height)
            spacing: dp(22)

            Card:
                id: focus_card
                orientation: "vertical"
                bg_color: theme.C.mint_soft
                border_color: theme.C.mint_line
                size_hint_y: None if root.stacked else 1
                height: self.minimum_height
                padding: [dp(22), dp(20)]
                spacing: dp(16)
                PanelHeading:
                    icon_name: "target"
                    icon_color: theme.C.mint_ink
                    title: "Weekly Focus"
                    subtitle: root.focus_subtitle
                BoxLayout:
                    id: focus_box
                    orientation: "vertical" if root.stacked else "horizontal"
                    size_hint_y: None
                    height: self.minimum_height if root.stacked else max([c.height for c in self.children] or [dp(56)])
                    spacing: dp(14)

            Card:
                id: progress_card
                orientation: "vertical"
                size_hint_x: None
                width: self.parent.width if root.stacked else dp(360)
                size_hint_y: None if root.stacked else 1
                height: self.minimum_height
                padding: [dp(22), dp(20)]
                spacing: dp(12)
                PanelHeading:
                    icon_name: "chart-column"
                    title: "Progress"
                Label:
                    markup: True
                    text: root.progress_markup
                    font_size: "17sp"
                    color: theme.C.ink
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]
                DashProgressBar:
                    value: root.progress
                    size_hint_y: None
                    height: dp(10)
                Label:
                    text: root.percent_text
                    font_size: "13sp"
                    color: theme.C.muted
                    text_size: self.width, None
                    halign: "right"
                    size_hint_y: None
                    height: self.texture_size[1]

        # ---- Row 2: Roadmap + Not Now ----
        BoxLayout:
            orientation: "vertical" if root.stacked else "horizontal"
            size_hint_y: None
            height: self.minimum_height if root.stacked else max(roadmap_card.minimum_height, notnow_card.minimum_height)
            spacing: dp(22)

            Card:
                id: roadmap_card
                orientation: "vertical"
                size_hint_y: None if root.stacked else 1
                height: self.minimum_height
                padding: [dp(22), dp(20)]
                spacing: dp(16)
                PanelHeading:
                    icon_name: "map"
                    title: "Your Semester Roadmap"
                    subtitle: "Steps in order. Open a step to see why it's next for you."
                BoxLayout:
                    id: steps_box
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(12)
                Widget:
                    # fills leftover height when Not Now is the taller card

            Card:
                id: notnow_card
                orientation: "vertical"
                bg_color: theme.C.crimson_tint
                border_color: theme.C.danger_border
                size_hint_x: None
                width: self.parent.width if root.stacked else dp(360)
                size_hint_y: None if root.stacked else 1
                height: self.minimum_height
                padding: [dp(22), dp(20)]
                spacing: dp(12)
                PanelHeading:
                    icon_name: "eye-off"
                    icon_color: theme.C.crimson
                    title_color: theme.C.crimson
                    title: "Not Now"
                    subtitle: "Things to skip for now, and why."
                BoxLayout:
                    id: notnow_items
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(14)
                Widget:


# =========================================================================
# State 2: generating
# =========================================================================

<DashboardLoadingView>:
    stacked: helpers.use_stacked_layout(self.width / dp(1))
    side_pad: 0
    orientation: "vertical"
    padding: [0, 0, 0, dp(24)]
    spacing: dp(18)

    DashCardFrame:
        size_hint_y: None
        height: self.minimum_height
        padding: [dp(24), dp(22)]
        spacing: dp(14)
        LoadingRing:
            id: ring
            pos_hint: {"center_y": 0.5}
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(2)
            pos_hint: {"center_y": 0.5}
            DashLabel:
                text: "Building your roadmap"
                color: theme.C.text
                font_size: "20sp"
                bold: True
            DashLabel:
                text: "Reading your intake and choosing steps that fit your hours. This can take up to a minute."
                color: theme.C.text_muted

    BoxLayout:
        orientation: "vertical" if root.stacked else "horizontal"
        size_hint_y: None
        height: self.minimum_height
        spacing: dp(28)
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(14)
            pos_hint: {"top": 1}
            DashSkeletonCard:
            DashSkeletonCard:
                title_share: 0.48
                line_share: 0.78
            DashSkeletonCard:
                title_share: 0.55
                line_share: 0.7
        DashNotNowFrame:
            size_hint_x: None
            width: self.parent.width if root.stacked else dp(340)
            spacing: dp(12)
            pos_hint: {"top": 1}
            DashSkeletonBar:
                height: dp(16)
                size_hint_x: 0.5
                fill: theme.C.skeleton_notnow_bar
            DashSkeletonBar:
                height: dp(54)
                fill: theme.C.notnow_card
            DashSkeletonBar:
                height: dp(54)
                fill: theme.C.notnow_card

    Widget:
        # empty filler: pushes everything above it to the top


# =========================================================================
# State 3: generation failed
# =========================================================================

<DashboardErrorView>:
    stacked: helpers.use_stacked_layout(self.width / dp(1))
    side_pad: 0
    orientation: "vertical"
    padding: [0, 0, 0, dp(24)]

    DashCardFrame:
        frame_line: theme.C.error_border
        frame_line_width: dp(1.5)
        orientation: "vertical"
        size_hint: None, None
        width: min(dp(640), root.width - 2 * root.side_pad)
        height: self.minimum_height
        padding: [dp(30), dp(28)]
        spacing: dp(12)
        DashLabel:
            text: "We couldn't build your roadmap"
            color: theme.C.text
            font_size: "20sp"
            bold: True
        DashLabel:
            text: "Your intake answers are saved, so nothing is lost. Try again in a moment. If it keeps failing, check your internet connection."
            color: theme.C.text_muted
            font_size: "15sp"
        DashLabel:
            # The controller's own message (spec, Errors: views show the message).
            text: ("Details: " + root.detail) if root.detail else ""
            color: theme.C.text_faint
            font_size: "12sp"
        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(12)
            DashPillButton:
                text: "Try again"
                on_release: root.screen.start_generation()
            DashPillButton:
                text: "Edit my intake"
                fill: theme.C.surface
                outline: theme.C.step_outline
                color: theme.C.text_label
                on_release: root.screen.edit_intake()
            Widget:

    Widget:


# =========================================================================
# The screen: top bar (always visible) + a body that holds one state view
# =========================================================================

<DashboardScreen>:
    stacked: helpers.use_stacked_layout(self.width / dp(1))
    # The Phase 1 screens use Kivy's default dark window background, so the
    # dashboard paints its own white background instead of changing the
    # window color for every screen.
    canvas.before:
        Color:
            rgba: theme.C.background
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        # Sidebar replaces the old top bar (Milestone 3 design). Log out and
        # Settings live in the sidebar now; see views/components.kv.
        Sidebar:
            active: "dashboard"

        BoxLayout:
            orientation: "vertical"
            padding: [dp(36), dp(28), dp(28), 0]
            spacing: dp(22)

            # ---- Page header ----
            BoxLayout:
                size_hint_y: None
                height: dp(64)
                BoxLayout:
                    orientation: "vertical"
                    Label:
                        text: "Dashboard"
                        bold: True
                        font_size: "30sp"
                        color: theme.C.ink
                        halign: "left"
                        valign: "bottom"
                        text_size: self.size
                    Label:
                        text: root.subtitle
                        font_size: "15sp"
                        color: theme.C.muted
                        halign: "left"
                        valign: "top"
                        text_size: self.size
                Icon:
                    name: "user"
                    color: theme.C.blue
                    size: dp(44), dp(44)
                    pos_hint: {"top": 1}
                    canvas.before:
                        Color:
                            rgba: theme.C.blue_tint
                        Ellipse:
                            pos: self.pos
                            size: self.size

            # ---- Body: dashboard.py puts exactly one state view in here ----
            BoxLayout:
                id: body
