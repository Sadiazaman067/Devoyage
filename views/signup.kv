#:import theme views.theme

# Sign up (Milestone 3 design): same layout as Log in, plus a confirm
# password field. Shared pieces are in components.kv.

<SignUpScreen>:
    canvas.before:
        Color:
            rgba: theme.C.bg
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        AuthPanel:
            size_hint_x: 0.54
        AnchorLayout:
            size_hint_x: 0.46
            anchor_x: "center"
            anchor_y: "center"
            BoxLayout:
                orientation: "vertical"
                size_hint: None, None
                width: min(dp(420), self.parent.width - dp(48))
                height: self.minimum_height
                spacing: dp(10)
                Label:
                    text: "Create your account"
                    bold: True
                    font_size: "32sp"
                    color: theme.C.ink
                    size_hint_y: None
                    height: dp(42)
                    text_size: self.size
                    halign: "left"
                    valign: "middle"
                Label:
                    text: "Start building your personalized roadmap."
                    font_size: "16sp"
                    color: theme.C.muted
                    size_hint_y: None
                    height: dp(26)
                    text_size: self.size
                    halign: "left"
                    valign: "top"
                Widget:
                    size_hint_y: None
                    height: dp(8)
                FieldTitle:
                    text: "Email"
                TextField:
                    id: email_field
                    icon_name: "mail"
                    hint_text: "Enter your email"
                FieldTitle:
                    text: "Password"
                TextField:
                    id: password_field
                    icon_name: "lock"
                    hint_text: "Enter your password"
                    password: True
                    revealable: True
                Label:
                    text: "At least 8 characters."
                    font_size: "13sp"
                    color: theme.C.muted
                    size_hint_y: None
                    height: dp(18)
                    text_size: self.size
                    halign: "left"
                    valign: "middle"
                FieldTitle:
                    text: "Confirm password"
                TextField:
                    id: confirm_field
                    icon_name: "lock"
                    hint_text: "Re-enter your password"
                    password: True
                    revealable: True
                ErrorBox:
                    id: error_box
                Widget:
                    size_hint_y: None
                    height: dp(4)
                PrimaryButton:
                    text: "Create account"
                    size_hint_x: 1
                    height: dp(50)
                    on_release: root.submit()
                LinkLabel:
                    prompt: "Already have an account?"
                    link_text: "Log in"
                    on_follow: root.go_to_login()
